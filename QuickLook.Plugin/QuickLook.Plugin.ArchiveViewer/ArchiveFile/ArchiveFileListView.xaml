<UserControl x:Class="QuickLook.Plugin.ArchiveViewer.ArchiveFile.ArchiveFileListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:QuickLook.Plugin.ArchiveViewer.ArchiveFile"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="archiveListView"
             d:DesignHeight="300"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <local:BooleanToAsteriskConverter x:Key="BooleanToAsteriskConverter" />
            <local:SizePrettyPrintConverter x:Key="SizePrettyPrintConverter" />
            <local:DatePrintConverter x:Key="DatePrintConverter" />
            <local:FileExtToIconConverter x:Key="FileExtToIconConverter" />
        </Grid.Resources>

        <!-- Fixed column widths avoid a shared-size measurement pass across the entire archive. -->
        <Grid Grid.Row="0" Margin="2,0,2,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="{x:Static SystemParameters.VerticalScrollBarWidth}" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="columnHeaders"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          Focusable="False">
                <Grid MinWidth="500">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="135" />
                        <ColumnDefinition Width="165" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Original Size" />
                    <TextBlock Grid.Column="2" Text="Modified Date" />
                </Grid>
            </ScrollViewer>
        </Grid>

        <!--
            A single flat item host is essential: nesting TreeViewItem hosts can generate
            thousands of containers while an expanded node is measured. The backing
            collection contains only visible (expanded) rows, while this ListBox only
            realizes rows in the viewport.
        -->
        <local:ArchiveFileListBox x:Name="fileList"
                 Grid.Row="1"
                 ItemsSource="{Binding Rows, ElementName=archiveListView}"
                 Background="Transparent"
                 BorderThickness="0"
                 Focusable="True"
                 SelectionMode="Single"
                 KeyboardNavigation.TabNavigation="Once"
                 PreviewKeyDown="NavigateTree"
                 MouseDoubleClick="ToggleRowByDoubleClick"
                 ScrollViewer.ScrollChanged="SynchronizeHeaders"
                 AutomationProperties.Name="Archive contents"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Focusable" Value="True" />
                    <Setter Property="ToolTip" Value="{Binding Entry.Name}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Entry.Name}" />
                    <Setter Property="MinHeight" Value="24" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ArchiveFileRow}">
                    <Grid MinHeight="24" MinWidth="500">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="165" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="{Binding IndentWidth}" />
                            <Button Grid.Column="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Focusable="False"
                                    IsTabStop="False"
                                    AutomationProperties.Name="{Binding Entry.Name}"
                                    AutomationProperties.HelpText="Expand or collapse folder"
                                    FontSize="13"
                                    Padding="0"
                                    Content="{Binding ExpansionGlyph}"
                                    IsEnabled="{Binding HasChildren}"
                                    Click="ToggleFolder" />
                            <Image Grid.Column="2" Width="16" Height="16">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource FileExtToIconConverter}">
                                        <Binding Path="Entry.Name" />
                                        <Binding Path="Entry.IsFolder" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                            <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Entry.Name, Mode=OneWay}" />
                                <Run Text="{Binding Entry.Encrypted, Converter={StaticResource BooleanToAsteriskConverter}}" />
                            </TextBlock>
                        </Grid>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SizePrettyPrintConverter}">
                                    <Binding Path="Entry.Size" />
                                    <Binding Path="Entry.IsFolder" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource DatePrintConverter}">
                                    <Binding Path="Entry.ModifiedDate" />
                                    <Binding Path="Entry.IsFolder" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </local:ArchiveFileListBox>
    </Grid>
</UserControl>
