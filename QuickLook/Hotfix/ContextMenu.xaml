<!--
    Local Hotfix (ported from Wpf.Ui.Violeta Hotfix/ContextMenu.xaml):
    DropShadowEffect must not wrap IsItemsHost content, otherwise WPF rasterizes
    menu text. Also drops upstream UiContextMenu From=-90 TranslateTransform
    slide-in that covers the host when Placement=Bottom.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui">

    <Style
        x:Key="DefaultDropDownFlyoutContextMenuStyle"
        BasedOn="{StaticResource UiContextMenu}"
        TargetType="{x:Type ContextMenu}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <ui:EffectThicknessDecorator Thickness="30">
                        <Grid x:Name="Border">
                            <!--  Shadow-only layer (no visual children → text stays sharp).  -->
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="20"
                                        Direction="270"
                                        Opacity="0.135"
                                        ShadowDepth="10"
                                        Color="#202020" />
                                </Border.Effect>
                            </Border>
                            <!--  Content layer without Effect / without From=-90 slide.  -->
                            <Border
                                Padding="0,3,0,3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel
                                    ClipToBounds="True"
                                    IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"
                                    Orientation="Vertical" />
                            </Border>
                        </Grid>
                    </ui:EffectThicknessDecorator>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultDropDownFlyoutContextMenuStyle}" TargetType="{x:Type ContextMenu}" />

</ResourceDictionary>
